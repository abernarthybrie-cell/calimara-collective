{
  "name": "ReadingTag",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "mood",
        "topic",
        "form",
        "length"
      ],
      "default": "mood"
    },
    "description": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "type"
  ]
}