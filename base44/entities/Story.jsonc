      "type": "string"
    },
    "issue_number": {
      "type": "number"
    },
    "category": {
      "type": "string"
    },
    "rubrica": {
      "type": "string"
    },
    "page_number": {
      "type": "number"
    },
    "artifact_start_page": {
      "type": "number"
    },
    "artifact_pages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "full_text": {
      "type": "string"
    },
    "excerpt": {
      "type": "string"
    },
    "cover_image": {
      "type": "string"
    },
    "page_scan": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mood_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "topic_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "form": {
      "type": "string"
    },
    "reading_time_min": {
      "type": "number"
    },
    "publication_date": {
      "type": "string",
      "format": "date"
    },
    "inspiration": {
      "type": "string"
    },
    "behind_the_scenes": {
      "type": "string"
    },
